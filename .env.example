# cp .env.example .env

# Optional PeerServer URL for signalling, e.g. https://peer.example.com/ or
# http://127.0.0.1:9000/ (the bundled PeerJS 0.3 client speaks the protocol of
# the `peer` 0.2.x server). Unset, the client uses its built-in PeerJS cloud
# default, http://0.peerjs.com:9000, which browsers force to https (peerjs.com
# is on the HSTS preload list), so that default does not connect.
# PEERJS_SERVER=
PEERJS_KEY=cnkznl0wfzf9wwmi
SESSION_SECRET=replace_with_a_random_string_at_least_32_chars
PORT=5000
IP=127.0.0.1
DB_PATH=./database/app.db
